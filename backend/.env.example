SATYA_ENVIRONMENT=development
SATYA_PERSISTENCE_MODE=local
SATYA_LOCAL_FALLBACK_ENABLED=true
SATYA_SUPABASE_URL=
SATYA_SUPABASE_KEY=
SATYA_MAX_UPLOAD_BYTES=26214400

# Set persistence to supabase and disable the local fallback for production.
# The service-role key must remain server-side and is intentionally not used
# by the browser.
SATYA_SUPABASE_SERVICE_ROLE_KEY=

# Model providers are extension points; no model weights are bundled.
SATYA_IMAGE_MODEL_PROVIDER=development
SATYA_VIDEO_MODEL_PROVIDER=development
SATYA_AUDIO_MODEL_PROVIDER=development
SATYA_TEXT_MODEL_PROVIDER=development
SATYA_LLM_PROVIDER=gemini
SATYA_LLM_API_KEY=
SATYA_WHISPER_API_KEY=
SATYA_WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
